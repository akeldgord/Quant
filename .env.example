# ARGUS environment configuration template.
# Copy to .env and fill in locally. NEVER commit the real .env file.
# Per MASTER_SPEC.md SEC-005 / section 108: this file contains empty
# placeholders only. Do not paste real credential values into chat or
# into this repository.

# --- Database ---
ARGUS_DB_HOST=localhost
ARGUS_DB_PORT=5432
ARGUS_DB_NAME=argus
ARGUS_DB_INGEST_USER=argus_ingest
ARGUS_DB_INGEST_PASSWORD=
ARGUS_DB_RESEARCH_USER=argus_research
ARGUS_DB_RESEARCH_PASSWORD=
ARGUS_DB_EXECUTOR_USER=argus_executor
ARGUS_DB_EXECUTOR_PASSWORD=
ARGUS_DB_ADMIN_USER=argus_admin
ARGUS_DB_ADMIN_PASSWORD=

# --- Providers (Phase 1+, not required for Phase 0) ---
HELIUS_API_KEY=
BIGQUERY_PROJECT_ID=
BIGQUERY_CREDENTIALS_JSON_PATH=

# --- Notifications (Phase 4+) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---
ARGUS_ENV=development
ARGUS_LOG_LEVEL=INFO

# --- Live execution (fail-closed defaults; see MASTER_SPEC.md section 73-74) ---
# The signing key is NEVER configured here. It lives outside the repo at
# /var/lib/argus/secrets/executor-keypair.json and is only readable by the
# isolated executor process/identity.
ARGUS_LIVE_ARM_FILE_PATH=/var/lib/argus/live_arm.json
# Path to a solana-keygen-format JSON keypair file (a 64-byte array),
# readable ONLY by the executor process/identity -- resolved and loaded
# (argus.executor.live_signing.FileKeypairSigner) exclusively inside the
# distinct `executor` Compose service (FSR-01, argus-final-spec-recovery-001).
# No other process/service ever reads this variable. Never set this to a
# path inside this repository.
ARGUS_EXECUTOR_SIGNER_KEY_PATH=/var/lib/argus/secrets/executor-keypair.json
# Host directory bind-mounted read-only into the `executor` Compose
# service at /var/lib/argus/secrets (see compose.yaml's `executor`
# profile) -- must contain the files the two paths above point at,
# provisioned by the operator outside this repository.
ARGUS_EXECUTOR_HOST_SECRETS_DIR=
